Bootstrap: docker
From: python:3.13-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        r-base \
        r-base-dev \
        curl \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir \
        "litellm>=1.40.0" \
        "instructor>=1.7.0" \
        "pydantic>=2.0.0"
    # RcppArmadillo (a MSstats dependency) requires a C++14 compiler, but R
    # falls back to -std=gnu++11 unless told otherwise, which fails with
    # "*** C++14 compiler required" from armadillo_bits/compiler_check.hpp.
    # Force C++14 as the default standard for all package builds, system-wide,
    # before anything gets compiled.
    mkdir -p /usr/lib/R/etc && \
    printf 'CXX11STD = -std=gnu++14\nCXX14 = g++\nCXX14STD = -std=gnu++14\n' >> /usr/lib/R/etc/Makevars.site
    # MSstats is a Bioconductor package with a fairly heavy transitive
    # dependency tree (ggplot2, limma, preprocessCore, ...). BiocManager
    # auto-selects the Bioconductor release matching the installed R version,
    # so this should self-adjust across R versions -- but if pak complains
    # about a version mismatch on HPC, pin BiocManager::install(version=...)
    # explicitly to match the R version apt installed.
    R -e 'install.packages("pak", repos = sprintf("https://r-lib.github.io/p/pak/stable/%s/%s/%s", .Platform$pkgType, R.Version()$os, R.Version()$arch)); pak::pkg_install(c("bioc::MSstats", "bioc::MSstatsConvert", "testthat", "callr"))'

%environment
    export MODEL=claude-opus-4-6
    export RUNS=1
    export PYTHONUNBUFFERED=1
